---
// Phần thân trang chủ: thẻ bắt đầu nhanh, các khu kiến thức (6 khu + công cụ + tra cứu), bản đồ lộ trình 6 chặng, 4 huy hiệu tin cậy.
// Tiến độ đọc lưu trong máy người xem (localStorage), do public/tuong-tac.js điền vào.
import fs from 'node:fs';
import path from 'node:path';
import { CHANG, MO_RONG } from '../data/chang.mjs';
import { KHU as DS_KHU } from '../data/khu.mjs';
import BieuTuong from './BieuTuong.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const tn = path.join(process.cwd(), 'src/data/thuat-ngu.json');
const thuatNgu = fs.existsSync(tn) ? JSON.parse(fs.readFileSync(tn, 'utf8')) : [];
const tn0 = thuatNgu[0];
const pg = path.join(process.cwd(), 'src/content/docs/tra-cuu.md');
const tcText = fs.existsSync(pg) ? fs.readFileSync(pg, 'utf8') : '';
const soPhuGia = (tcText.match(/class="the-pg/g) || []).length;
const soTu = (tcText.match(/class="td-hang/g) || []).length;

const soBai = (k) => DS_KHU[k].bai.length;
const KHU = [
	{ ten: 'Nhũ tương', mo: 'Trục chính: 6 chặng từ nền tảng đến sản phẩm, kèm hệ đặc biệt và xử lý sự cố.', khu: 'nhu-tuong', href: '/nhu-tuong/', icon: 'giot', mau: 'var(--chang-1)' },
	{ ten: 'Chất béo', mo: 'Cấu trúc TAG, đa hình tinh thể, SFC, oleogel, oxy hóa và hạn dùng.', khu: 'chat-beo', href: '/chat-beo/', icon: 'chat-beo', mau: 'var(--khu-chat-beo)' },
	{ ten: 'Chất nhũ hóa', mo: 'HLB, lecithin, MDG, polysorbate, cạnh tranh hấp phụ với protein, mã INS.', khu: 'chat-nhu-hoa', href: '/chat-nhu-hoa/', icon: 'chat-nhu-hoa', mau: 'var(--khu-chat-nhu-hoa)' },
	{ ten: 'Chất ổn định', mo: 'Xanthan, galactomannan, carrageenan, pectin, gellan, gum arabic.', khu: 'chat-on-dinh', href: '/chat-on-dinh/', icon: 'chat-on-dinh', mau: 'var(--khu-chat-on-dinh)' },
	{ ten: 'Thực phẩm', mo: 'Giữ nước thịt, bảo quản và hoạt độ nước, Maillard, tinh bột, protein, quá trình nhiệt, ADI phụ gia.', khu: 'thuc-pham', href: '/thuc-pham/', icon: 'thuc-pham', mau: 'var(--khu-thuc-pham)' },
	{ ten: 'Dược phẩm', mo: 'Bào chế: tá dược, hòa tan và BCS, kem và nhũ tương tiêm, hệ nano, viên nén, độ ổn định ICH, QbD.', khu: 'duoc-pham', href: '/duoc-pham/', icon: 'duoc', mau: 'var(--khu-duoc-pham)' },
	{ ten: 'Phòng lab ảo', mo: 'Trò chơi: tự cân dầu, chạy máy đồng hóa, xem mẻ của bạn có tách lớp hay bị ôi không. Kết quả tính bằng cơ chế thật trong bài.', chip: '4 nhiệm vụ', href: '/phong-lab/', icon: 'vo-giot', mau: 'var(--chang-3)' },
	{ ten: 'Máy tính và chẩn đoán', mo: 'Stokes, Laplace, Debye, Ostwald, Pickering, HLB, hạn dùng Arrhenius, TOTOX, IV/SV, axit yếu, giá trị F, cây chẩn đoán.', chip: '13 máy tính · 1 cây', href: '/may-tinh/', icon: 'may-tinh', mau: '#2f6fd6' },
	{ ten: 'Tra cứu: INS, mức tối đa, từ điển', mo: 'Mã INS/E (EFSA, ADI), mức tối đa phụ gia theo Thông tư 24/2019 theo chất hoặc nhóm thực phẩm, và từ điển Anh–Việt.', chip: `${soPhuGia} thẻ · 400 chất TT24 · ${soTu} từ`, href: '/tra-cuu/', icon: 'tra-cuu', mau: '#5b6b74' },
];
const NHAN = [
	['N', 'Có nguồn', 'Đã đọc nguồn; bấm tên nguồn để xem thẻ nguồn.'],
	['T', 'Tính minh họa', 'Ví dụ tự tính, giả thiết ghi kèm.'],
	['K', 'Sách nền', 'Kiến thức giáo khoa, chưa trích số trang; số liệu đang tạm ẩn.'],
	['G', 'Suy luận', 'Diễn giải hoặc giả thuyết, cần kiểm bằng thí nghiệm.'],
];
---

<div class="not-content tc-than">
	<!-- Bắt đầu nhanh -->
	<div class="tc-nhanh">
		<a class="tc-the-nhanh" href={`${base}/nhu-tuong/nen-tang/`} data-tiep-tuc>
			<span class="tcn-icon tcn-chinh" aria-hidden="true">▶</span>
			<span class="tcn-chu">
				<b data-tiep-tuc-tieu-de>Bắt đầu đọc</b>
				<small data-tiep-tuc-mo>Chặng 1 · Nền tảng</small>
			</span>
			<span class="tcn-mui" aria-hidden="true">›</span>
		</a>
		<a class="tc-the-nhanh" href={`${base}/chan-doan/`}>
			<span class="tcn-icon" aria-hidden="true">?</span>
			<span class="tcn-chu">
				<b>Sản phẩm bị tách lớp?</b>
				<small>Trả lời vài câu, tìm mắt xích hỏng</small>
			</span>
			<span class="tcn-mui" aria-hidden="true">›</span>
		</a>
		{tn0 && (
			<div class="tc-the-nhanh tc-khai-niem" data-khai-niem>
				<span class="tcn-icon tcn-ho-phach" aria-hidden="true">Aa</span>
				<span class="tcn-chu">
					<small class="tcn-tren">Khái niệm hôm nay</small>
					<b data-kn-vi>{tn0.vi}</b>
					<small><i data-kn-en>{tn0.en}</i> · <span data-kn-mo>{tn0.mo}</span></small>
				</span>
				<a class="tcn-xem" href={`${base}/nhu-tuong/thuat-ngu/`} data-kn-link>Bảng thuật ngữ</a>
			</div>
		)}
	</div>
	<script type="application/json" id="du-lieu-thuat-ngu" set:html={JSON.stringify(thuatNgu)} />

	<!-- Các khu -->
	<h2 class="tc-muc"><span>Chọn một khu</span></h2>
	<div class="tc-khu">
		{KHU.map((k) => {
			const Tag = k.href ? 'a' : 'div';
			return (
				<Tag class:list={['tc-khu-the', { sap: !k.href }]} href={k.href && `${base}${k.href}`} style={`--mau: ${k.mau}`}>
					<span class="tck-hinh">
						<BieuTuong ten={k.icon} co={64} />
					</span>
					<span class="tck-ten">{k.ten}</span>
					<span class="tck-mo">{k.mo}</span>
					{k.khu ? (
						<span class="tck-chip" data-tien-do-khu={k.khu} data-tong={soBai(k.khu)}>
							{soBai(k.khu)} bài
						</span>
					) : (
						<span class="tck-chip">{k.chip}</span>
					)}
				</Tag>
			);
		})}
	</div>

	<!-- Bản đồ lộ trình -->
	<h2 class="tc-muc"><span>Lộ trình nhũ tương</span><small data-tong-tien-do>Đã đọc 0/{CHANG.length + MO_RONG.length} bài</small></h2>
	<div class="tc-lo-trinh">
		<div class="lt-thanh"><span data-thanh-tien-do style="width:0%"></span></div>
		<ol class="lt-ds">
			{CHANG.map((c) => (
				<li style={`--mau: var(--chang-${c.so})`}>
					<a class="lt-nut" href={`${base}/nhu-tuong/${c.slug}/`} data-slug={c.slug}>
						<span class="lt-tron">
							<BieuTuong ten={c.bieuTuong} co={30} />
							<span class="lt-so">{c.so}</span>
						</span>
						<span class="lt-chu">
							<b>{c.ten}</b>
							<small>{c.cauHoi}</small>
							<span class="lt-trang-thai" data-trang-thai>Chưa đọc</span>
						</span>
					</a>
				</li>
			))}
		</ol>
		<div class="lt-mo-rong">
			{MO_RONG.map((c) => (
				<a class="lt-nhanh" href={`${base}/nhu-tuong/${c.slug}/`} data-slug={c.slug}>
					<b>{c.ten}</b>
					<small>{c.cauHoi}</small>
					<span class="lt-trang-thai" data-trang-thai>Chưa đọc</span>
				</a>
			))}
		</div>
	</div>

	<!-- Huy hiệu -->
	<h2 class="tc-muc"><span>Mỗi câu đều nói rõ nó dựa vào đâu</span></h2>
	<div class="tc-nhan">
		{NHAN.map(([k, ten, mo]) => (
			<a class="tc-nhan-the" href={`${base}/quy-uoc/`}>
				<span class:list={['nhan', `nhan-${k}`, 'tc-nhan-to']}>{k}</span>
				<span>
					<b>{ten}</b>
					<small>{mo}</small>
				</span>
			</a>
		))}
	</div>
</div>
