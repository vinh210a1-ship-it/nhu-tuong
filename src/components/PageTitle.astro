---
// Tiêu đề bài. Với bài thuộc lộ trình nhũ tương: thêm dải chặng (đang ở chặng mấy, câu hỏi bài trả lời,
// thời gian đọc ước tính, 6 chấm chặng bấm được) và tô màu riêng của chặng cho tiêu đề mục, khung trích.
// Với bài của các khu khác (chất béo, chất nhũ hóa, chất ổn định): cùng kiểu dải, đánh số bài trong khu, màu của khu.
import { CHANG, MO_RONG } from '../data/chang.mjs';
import { KHU } from '../data/khu.mjs';
import BieuTuong from './BieuTuong.astro';

const route = Astro.locals.starlightRoute;
const { title } = route.entry.data;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const [khu, slug] = route.id.split('/');
const chang = khu === 'nhu-tuong' ? CHANG.find((c) => c.slug === slug) : undefined;
const moRong = khu === 'nhu-tuong' ? MO_RONG.find((c) => c.slug === slug) : undefined;
const khuKhac = khu !== 'nhu-tuong' && KHU[khu] && slug ? KHU[khu] : undefined;
const viTri = khuKhac ? khuKhac.bai.findIndex((b) => b.slug === slug) : -1;
const baiKhu = viTri >= 0 ? khuKhac.bai[viTri] : undefined;
const laBai = Boolean(chang || moRong || baiKhu);
// Ước tính thời gian đọc: đếm âm tiết, ~220 âm tiết/phút; bỏ bảng và nhãn
const than = (route.entry.body || '').replace(/\[(?:N|K|T|G)[^\]]*\]/g, '').replace(/^\|.*$/gm, '');
const phut = Math.max(1, Math.round(than.split(/\s+/).filter(Boolean).length / 220));
const mau = chang ? `var(--chang-${chang.so})` : baiKhu ? khuKhac.mau : 'var(--chang-7)';
// các nấc của thanh bước: 6 chặng nhũ tương, hoặc các bài của khu
const buoc = baiKhu
	? khuKhac.bai.map((b, i) => ({ so: i + 1, slug: b.slug, ten: b.ten, href: `${base}/${khu}/${b.slug}/`, khoa: `${khu}/${b.slug}`, mau: khuKhac.mau, goi: `Bài ${i + 1}` }))
	: CHANG.map((c) => ({ so: c.so, slug: c.slug, ten: c.ten, href: `${base}/nhu-tuong/${c.slug}/`, khoa: c.slug, mau: `var(--chang-${c.so})`, goi: `Chặng ${c.so}` }));
const icon = chang ? chang.bieuTuong : baiKhu ? khuKhac.icon : slug === 'he-dac-biet' ? 'giot' : 'phan-bo';
const nhan = chang
	? `Chặng ${chang.so} / 6 · Nhũ tương`
	: baiKhu
		? `${khuKhac.ten} · Bài ${viTri + 1} / ${khuKhac.bai.length}`
		: 'Mở rộng · Nhũ tương';
---

{
	laBai ? (
		<div class="dai-chang" style={`--mau-chang: ${mau}`}>
			<style set:html={`:root{--mau-chang:${mau}}`} />
			<div class="dc-dau">
				<span class="dc-icon">
					<BieuTuong ten={icon} co={34} />
				</span>
				<span class="dc-nhan">
					{nhan}
					<span class="dc-phut">khoảng {phut} phút đọc</span>
				</span>
			</div>
			<h1 id="_top">{title}</h1>
			<p class="dc-cau-hoi">
				<b>Bài này trả lời:</b> {(chang || moRong || baiKhu).cauHoi}.
			</p>
			<ol class="dc-buoc" aria-label={baiKhu ? `Các bài của khu ${khuKhac.ten}` : 'Các chặng'}>
				{buoc.map((c) => (
					<li class:list={{ 'dang-o': c.slug === slug }} style={`--mau: ${c.mau}`}>
						<a href={c.href} data-slug={c.khoa} title={`${c.goi}: ${c.ten}`}>
							<span class="dc-so">{c.so}</span>
							<span class="dc-ten">{c.ten}</span>
						</a>
					</li>
				))}
			</ol>
		</div>
	) : (
		<h1 id="_top" class="tieu-de-thuong">{title}</h1>
	)
}
